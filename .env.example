# ─────────────────────────────────────────────────────────────
# TesterHero – Umgebungsvariablen
# Lokal: Datei nach .env.local kopieren und ausfüllen.
# Vercel: Unter Project → Settings → Environment Variables eintragen.
# ─────────────────────────────────────────────────────────────

# Postgres-Verbindung (z. B. Neon über den Vercel Marketplace – setzt DATABASE_URL automatisch)
DATABASE_URL=postgresql://testerhero:testerhero@localhost:5432/testerhero

# Geheimer Schlüssel zum Signieren von Sessions & Links (mind. 32 Zeichen)
# Erzeugen mit: openssl rand -base64 32
AUTH_SECRET=

# Zugang zum Agentur-Bereich (/admin)
ADMIN_EMAIL=team@deine-agentur.de
ADMIN_PASSWORD=

# Schutz für den täglichen Verteil-Job (/api/cron/verteilen). Vercel schickt ihn automatisch mit.
CRON_SECRET=

# Öffentliche Adresse der Seite (für Links in E-Mails). Auf Vercel optional.
APP_URL=http://localhost:3000

# E-Mail-Versand über Resend (https://resend.com). Ohne Key werden E-Mails nur im Server-Log ausgegeben.
RESEND_API_KEY=
EMAIL_FROM="TesterHero <hallo@testerhero.app>"
# Optional: Antwortadresse für Tester-Rückfragen
EMAIL_REPLY_TO=

# Optional: Vercel Blob für Produktbild-Uploads (wird beim Verbinden eines Blob-Stores automatisch gesetzt)
BLOB_READ_WRITE_TOKEN=
